# ============================================================
#  Amazon Price Error Monitor — all env variables (one place)
#  Copy to ".env" locally, or paste into Render → Environment.
# ============================================================
# Already have these? Skip them, add only the REMAINING block.
# ============================================================

# --- REQUIRED (you said you already set these) ---------------
KEEPA_API_KEY=
UI_PASSWORD=
DISCORD_WEBHOOK_50=
DISCORD_WEBHOOK_60=
DISCORD_WEBHOOK_70=
DISCORD_WEBHOOK_80=

# Per-channel on/off (false = no alerts to that webhook)
CHANNEL_ENABLED_50=true
CHANNEL_ENABLED_60=true
CHANNEL_ENABLED_70=true
CHANNEL_ENABLED_80=true

# --- OPTIONAL pings (blank = no ping) ------------------------
DISCORD_PING_50=
DISCORD_PING_60=
DISCORD_PING_70=
DISCORD_PING_80=

# --- REMAINING — paste these on Render (defaults ready) ------
DATA_DIR=/var/data
KEEPA_DOMAIN=1
PRICE_TYPE=0
DATE_RANGE=3
ROUTE_MODE=highest
POLL_INTERVAL_SEC=1500
MIN_DISCOUNT=50
ALERT_COOLDOWN_HOURS=24
REFERENCE_MODE=keepa_avg
MAX_ALERTS_PER_TIER=1
ENRICH_ON_ALERT=true
NO_REPEAT_SAME_DAY=true
ALLOW_CHEAPER_REPEAT=true
MIN_ORIGINAL_PRICE=4
MIN_REVIEW_COUNT=0
MIN_RATING=0
INCLUDE_CATEGORIES=
EXCLUDE_CATEGORIES=
INCLUDE_BRANDS=
EXCLUDE_BRANDS=
SELLER_TYPE=fba
TITLE_KEYWORDS=
EXCLUDE_KEYWORDS=
ENRICH_PRODUCTS=false
REQUIRE_LOWEST=true
MIN_RECENT_DISCOUNT=40
REJECT_PROMOTIONS=true
REJECT_BUSINESS=true
VERIFY_LIVE_PRICE=true
INCLUDE_GRAPH=true
LOG_LEVEL=INFO

# --- NOTES ---------------------------------------------------
# Tiers: Amazon-50 / 60 / 70 / 80 only. No DISCORD_WEBHOOK_90.
# Amazon-80 = 80–89% only. Discount >= 90 is never alerted.
# Keepa Pro ~1 token/min → POLL_INTERVAL_SEC=1500 (25 min).
# Local: leave DATA_DIR blank (uses ./data).
# Render UI can override interval/webhooks only AFTER you Save in UI
# (creates ui_settings.json). Until then env is source of truth.
