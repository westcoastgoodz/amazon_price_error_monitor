# ============================================================
#  Amazon Price Error Monitor  -  configuration
#  Copy this file to ".env" and fill in your own values.
# ============================================================

# --- Keepa ---------------------------------------------------
# Paid Keepa API key (https://keepa.com/#!api). Required.
KEEPA_API_KEY=

# Amazon marketplace / Keepa domain id:
# 1=US  2=UK  3=DE  4=FR  5=JP  6=CA  8=IT  9=ES  10=IN  11=MX
KEEPA_DOMAIN=1

# Which Keepa price type the discount is measured on:
# 0=Amazon  1=New (buy box / marketplace new)  2=Used
PRICE_TYPE=1

# Reference window for the "old price" / discount %:
# 0=day  1=week(7d)  2=month(31d)  3=90 days
DATE_RANGE=3

# --- Discord webhooks (one per discount tier) ----------------
# Create 4 channels in Discord (Amazon-60 / -70 / -80 / -90),
# add a webhook to each and paste the URLs below.
DISCORD_WEBHOOK_60=
DISCORD_WEBHOOK_70=
DISCORD_WEBHOOK_80=
DISCORD_WEBHOOK_90=

# Optional ping put in front of every alert in each tier.
# Examples:  @everyone   |   <@&ROLE_ID>   |   <@USER_ID>
DISCORD_PING_60=
DISCORD_PING_70=
DISCORD_PING_80=
DISCORD_PING_90=

# How to route a deal across tiers:
#   highest  -> post only to the single highest tier it qualifies for (85% -> Amazon-80)
#   cascade  -> post to every tier it clears (85% -> 60,70,80)
ROUTE_MODE=highest

# --- Monitoring ----------------------------------------------
# Seconds between Keepa deal scans.
# Keepa Pro (~1 token/min): use 600+ so we don't burn tokens.
POLL_INTERVAL_SEC=600

# Minimum discount % to consider at all (lowest tier).
MIN_DISCOUNT=60

# Re-alert the same ASIN only after this many hours (unless price drops further).
ALERT_COOLDOWN_HOURS=24

# How the "old price" / discount is measured:
#   keepa_avg   -> use Keepa's average over DATE_RANGE (e.g. 90-day history)
#   rolling_30d -> use the highest price this bot has seen locally in the last 30 days
REFERENCE_MODE=keepa_avg

# --- Filters -------------------------------------------------
# Skip deals whose ORIGINAL (old) price is below this. Client rule: 8.99
MIN_ORIGINAL_PRICE=8.99

# Skip products with fewer reviews / lower rating than these (needs ENRICH_PRODUCTS=true).
MIN_REVIEW_COUNT=0
MIN_RATING=0

# Comma-separated Keepa category ids to include / exclude (blank = all).
INCLUDE_CATEGORIES=
EXCLUDE_CATEGORIES=

# Comma-separated brand allow / block lists (blank = all). Needs ENRICH_PRODUCTS=true.
INCLUDE_BRANDS=
EXCLUDE_BRANDS=

# Buy-box seller type filter: any | fba | fbm | amazon. Needs ENRICH_PRODUCTS=true.
SELLER_TYPE=any

# Only keep titles containing ANY of these keywords (blank = all).
TITLE_KEYWORDS=
# Drop titles containing ANY of these keywords.
EXCLUDE_KEYWORDS=

# Fetch full product details (seller/brand/reviews/rating/coupon).
# Costs extra Keepa tokens. Keep false on Keepa Pro until more tokens available.
ENRICH_PRODUCTS=false

# --- Presentation --------------------------------------------
# Embed the Keepa price-history graph image at the bottom of each alert.
INCLUDE_GRAPH=true

# INFO or DEBUG
LOG_LEVEL=INFO

# --- Deploy / Render (optional) ------------------------------
# Persistent folder for monitor.db + ui_settings.json.
# On Render with a disk mounted at /var/data, set:
# DATA_DIR=/var/data
DATA_DIR=

# If set, the web UI requires this password (recommended on public URLs).
UI_PASSWORD=
